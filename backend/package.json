{
  "name": "frigosaas-api",
  "version": "1.0.0",
  "description": "Frigo SaaS REST API — Node.js + MongoDB",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "seed:platform": "tsx scripts/seed-platform.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test": "vitest run --config vitest.unit.config.ts && vitest run tests/integration/01-routes.test.ts && vitest run tests/integration/02-security.test.ts && vitest run tests/integration/03-platform.test.ts",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run",
    "test:security": "vitest run tests/integration/02-security.test.ts tests/integration/03-platform.test.ts",
    "migrate:firebase": "tsx scripts/migrate-from-firebase.ts",
    "migrate:firebase:dry": "DRY_RUN=true tsx scripts/migrate-from-firebase.ts",
    "promote:imported": "tsx scripts/promote-imported.ts",
    "fix:ids": "tsx scripts/fix-firebase-ids.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "firebase": "^9.17.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^0.29.8"
  }
}
