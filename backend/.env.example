# Backend environment — copy to backend/.env

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB — platform registry (clients list, subscriptions, super-admins)
PLATFORM_MONGODB_URI=mongodb://localhost:27017/frigosmart_platform

# MongoDB — default/legacy tenant connection base
MONGODB_BASE_URI=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017/frigosaas

# JWT — USE STRONG RANDOM SECRETS IN PRODUCTION (min 32 chars)
JWT_SECRET=change-me-tenant-secret-min-32-chars!!
PLATFORM_JWT_SECRET=change-me-platform-secret-min-32-chars!!
JWT_EXPIRES_IN=7d
PLATFORM_JWT_EXPIRES_IN=8h

# Tenant resolution
DEFAULT_TENANT_ID=YAZAMI
# In production, unregistered tenants are rejected automatically
# REQUIRE_TENANT_REGISTRY=true

# Connection pooling (scale)
MONGO_MAX_POOL_SIZE=10
TENANT_MAX_CONNECTIONS=40
TENANT_CONNECTION_IDLE_MS=600000
ORG_CACHE_TTL_MS=60000
